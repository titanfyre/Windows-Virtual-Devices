[Version]
Signature="$WINDOWS NT$"
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
CatalogFile=WindowsVirtualDevices.cat
DriverVer=10/27/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTamd64.10.0...19041

[Devices.NTamd64.10.0...19041]
%Device%=Install,ROOT\WindowsVirtualDevices

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
DemoSessionClock.sys=1
WindowsVirtualDevices.sys=1

[Install.NT]
CopyFiles=DriverFiles

[DriverFiles]
DemoSessionClock.sys
WindowsVirtualDevices.sys

[Install.NT.Services]
AddService=WindowsVirtualDevices,0x00000002,Service
AddService=WindowsVirtualDevicesDemoClock,0,TrialClockService

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WindowsVirtualDevices.sys

[Install.NT.Wdf]
KmdfService=WindowsVirtualDevices,Wdf

[Wdf]
KmdfLibraryVersion=1.31

[Strings]
Provider="titanfyre"
Device="Windows Virtual Devices Controller"
Disk="WindowsVirtualDevices installation media"

[TrialClockService]
DisplayName="titanfyre per-boot demo clock"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\DemoSessionClock.sys
